<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             https://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Auth2FA</display-name>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <default-content-type>text/html;charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>

    <filter>
        <filter-name>FiltroSesion</filter-name>
        <filter-class>mx.uacm.auth2fa.controlador.FiltroSesion</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FiltroSesion</filter-name>
        <url-pattern>/acceso</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>mx.uacm.auth2fa.controlador.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PreguntasServlet</servlet-name>
        <servlet-class>mx.uacm.auth2fa.controlador.PreguntasServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PreguntasServlet</servlet-name>
        <url-pattern>/preguntas</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>mx.uacm.auth2fa.controlador.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- La vista permanece bajo WEB-INF y se publica con una ruta lógica
         protegida por FiltroSesion. -->
    <servlet>
        <servlet-name>AccesoVista</servlet-name>
        <jsp-file>/WEB-INF/vistas/acceso.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccesoVista</servlet-name>
        <url-pattern>/acceso</url-pattern>
    </servlet-mapping>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>

</web-app>
